CREATE TABLE members (
  id TEXT NOT NULL PRIMARY KEY,
  account_id TEXT,
  owner_id TEXT,
  hiragana_first_name TEXT,
  hiragana_last_name TEXT,
  kanji_first_name TEXT,
  kanji_last_name TEXT,
  first_name TEXT,
  last_name TEXT,
  display_name TEXT NOT NULL,
  type TEXT,
  birthday INTEGER,
  gender TEXT,
  email TEXT,
  phone_number TEXT,
  UNIQUE (account_id)
) AS SqliteMemberRow;

CREATE INDEX members_owner_id_idx ON members (owner_id);

CREATE TABLE "groups" (
  id TEXT NOT NULL PRIMARY KEY,
  owner_id TEXT NOT NULL,
  name TEXT NOT NULL,
  memo TEXT,
  color TEXT NOT NULL DEFAULT '#4CAF50' CHECK (length(color) = 7 AND substr(color, 1, 1) = '#' AND substr(color, 2) NOT GLOB '*[^0-9a-fA-F]*'),
  text_color TEXT CHECK (text_color IS NULL OR (length(text_color) = 7 AND substr(text_color, 1, 1) = '#' AND substr(text_color, 2) NOT GLOB '*[^0-9a-fA-F]*'))
) AS SqliteGroupRow;

CREATE INDEX groups_owner_id_idx ON "groups" (owner_id);

CREATE TABLE group_members (
  group_id TEXT NOT NULL,
  member_id TEXT NOT NULL,
  is_administrator INTEGER NOT NULL CHECK (is_administrator IN (0, 1)),
  order_index INTEGER NOT NULL,
  color TEXT NOT NULL DEFAULT '#2196F3' CHECK (length(color) = 7 AND substr(color, 1, 1) = '#' AND substr(color, 2) NOT GLOB '*[^0-9a-fA-F]*'),
  text_color TEXT CHECK (text_color IS NULL OR (length(text_color) = 7 AND substr(text_color, 1, 1) = '#' AND substr(text_color, 2) NOT GLOB '*[^0-9a-fA-F]*')),
  PRIMARY KEY (group_id, member_id)
) AS SqliteGroupMemberRow;

CREATE INDEX group_members_group_id_idx ON group_members (group_id, order_index);

CREATE INDEX group_members_member_id_idx ON group_members (member_id, order_index);

CREATE TABLE trip_entries (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  year INTEGER NOT NULL,
  name TEXT,
  start_date INTEGER,
  end_date INTEGER,
  memo TEXT
) AS SqliteTripEntryRow;

CREATE INDEX trip_entries_group_id_idx ON trip_entries (group_id, year);

CREATE TABLE tasks (
  id TEXT NOT NULL PRIMARY KEY,
  trip_id TEXT NOT NULL REFERENCES trip_entries(id) ON DELETE CASCADE,
  order_index INTEGER NOT NULL,
  parent_task_id TEXT,
  name TEXT NOT NULL,
  is_completed INTEGER NOT NULL CHECK (is_completed IN (0, 1)),
  due_date INTEGER,
  memo TEXT,
  assigned_member_id TEXT,
  UNIQUE (id, trip_id),
  FOREIGN KEY (parent_task_id, trip_id) REFERENCES tasks(id, trip_id) DEFERRABLE INITIALLY DEFERRED
) AS SqliteTaskRow;

CREATE INDEX tasks_trip_id_idx ON tasks (trip_id, order_index);

CREATE INDEX tasks_assigned_member_id_idx ON tasks (assigned_member_id, order_index);

CREATE INDEX tasks_parent_task_id_idx ON tasks (parent_task_id, order_index);

CREATE TABLE itinerary_items (
  id TEXT NOT NULL PRIMARY KEY,
  trip_id TEXT NOT NULL REFERENCES trip_entries(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  start_date_time INTEGER,
  end_date_time INTEGER,
  memo TEXT
) AS SqliteItineraryItemRow;

CREATE INDEX itinerary_items_trip_id_idx ON itinerary_items (trip_id, start_date_time);

CREATE TABLE member_events (
  id TEXT NOT NULL PRIMARY KEY,
  member_id TEXT NOT NULL,
  year INTEGER NOT NULL,
  memo TEXT NOT NULL,
  UNIQUE (member_id, year)
) AS SqliteMemberEventRow;

CREATE TABLE group_events (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  year INTEGER NOT NULL,
  memo TEXT NOT NULL
) AS SqliteGroupEventRow;

CREATE TABLE dvc_point_contracts (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  contract_name TEXT NOT NULL,
  contract_start_year_month INTEGER NOT NULL,
  contract_end_year_month INTEGER NOT NULL,
  use_year_start_month INTEGER NOT NULL,
  annual_point INTEGER NOT NULL
) AS SqliteDvcPointContractRow;

CREATE TABLE dvc_limited_points (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  contract_id TEXT NOT NULL REFERENCES dvc_point_contracts(id) ON DELETE RESTRICT,
  start_year_month INTEGER NOT NULL,
  end_year_month INTEGER NOT NULL,
  point INTEGER NOT NULL,
  memo TEXT
) AS SqliteDvcLimitedPointRow;

CREATE TABLE dvc_point_usages (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  contract_id TEXT NOT NULL REFERENCES dvc_point_contracts(id) ON DELETE RESTRICT,
  usage_year_month INTEGER NOT NULL,
  used_point INTEGER NOT NULL,
  memo TEXT
) AS SqliteDvcPointUsageRow;

CREATE INDEX group_events_group_year_idx ON group_events (group_id, year);
CREATE INDEX dvc_point_contracts_group_start_idx ON dvc_point_contracts (group_id, contract_start_year_month);
CREATE INDEX dvc_limited_points_contract_idx ON dvc_limited_points (contract_id);
CREATE INDEX dvc_point_usages_contract_idx ON dvc_point_usages (contract_id);
CREATE INDEX dvc_limited_points_group_start_idx ON dvc_limited_points (group_id, start_year_month);
CREATE INDEX dvc_point_usages_group_month_idx ON dvc_point_usages (group_id, usage_year_month);

CREATE TABLE calendar_labels (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  color TEXT NOT NULL CHECK (length(color) = 7 AND substr(color, 1, 1) = '#' AND substr(color, 2) NOT GLOB '*[^0-9a-fA-F]*'),
  text_color TEXT NOT NULL DEFAULT '#FFFFFF' CHECK (length(text_color) = 7 AND substr(text_color, 1, 1) = '#' AND substr(text_color, 2) NOT GLOB '*[^0-9a-fA-F]*'),
  sort_order INTEGER NOT NULL DEFAULT 0 CHECK (sort_order >= 0),
  UNIQUE (id, group_id)
) AS SqliteCalendarLabelRow;

CREATE INDEX calendar_labels_group_idx ON calendar_labels (group_id);

CREATE TABLE calendar_events (
  notification_minutes_before TEXT NOT NULL DEFAULT '[]',
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  label_id TEXT,
  label_type TEXT NOT NULL,
  member_id TEXT,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  start_date_time INTEGER NOT NULL,
  end_date_time INTEGER NOT NULL CHECK (end_date_time >= start_date_time),
  is_all_day INTEGER NOT NULL CHECK (is_all_day IN (0, 1)),
  recurrence_rule TEXT,
  time_zone TEXT,
  UNIQUE (id, group_id),
  CHECK ((label_type = 'group' AND member_id IS NULL AND label_id IS NULL)
      OR (label_type = 'member' AND member_id IS NOT NULL AND length(trim(member_id)) > 0 AND label_id IS NULL)
      OR (label_type = 'custom' AND member_id IS NULL AND label_id IS NOT NULL)),
  CHECK (recurrence_rule IS NOT NULL OR time_zone IS NULL),
  CHECK (recurrence_rule IS NULL OR is_all_day = 1 OR length(trim(time_zone)) > 0),
  FOREIGN KEY (label_id, group_id) REFERENCES calendar_labels(id, group_id) ON DELETE NO ACTION
) AS SqliteCalendarEventRow;

CREATE INDEX calendar_events_group_start_idx ON calendar_events (group_id, start_date_time);
CREATE INDEX calendar_events_label_idx ON calendar_events (label_id);

CREATE TABLE calendar_event_overrides (
  notification_minutes_before TEXT NOT NULL DEFAULT '[]',
  event_id TEXT NOT NULL,
  group_id TEXT NOT NULL,
  original_start_date_time INTEGER NOT NULL,
  is_cancelled INTEGER NOT NULL CHECK (is_cancelled IN (0, 1)),
  title TEXT,
  start_date_time INTEGER,
  end_date_time INTEGER,
  is_all_day INTEGER CHECK (is_all_day IN (0, 1)),
  label_id TEXT,
  label_type TEXT,
  member_id TEXT,
  PRIMARY KEY (event_id, original_start_date_time),
  FOREIGN KEY (event_id, group_id) REFERENCES calendar_events(id, group_id) ON DELETE CASCADE,
  FOREIGN KEY (label_id, group_id) REFERENCES calendar_labels(id, group_id) ON DELETE NO ACTION,
  CHECK (is_cancelled = 1 OR (title IS NOT NULL AND length(trim(title)) > 0 AND start_date_time IS NOT NULL AND end_date_time IS NOT NULL AND end_date_time >= start_date_time AND is_all_day IS NOT NULL AND label_type IS NOT NULL AND ((label_type = 'group' AND member_id IS NULL AND label_id IS NULL) OR (label_type = 'member' AND member_id IS NOT NULL AND length(trim(member_id)) > 0 AND label_id IS NULL) OR (label_type = 'custom' AND member_id IS NULL AND label_id IS NOT NULL))))
) AS SqliteCalendarEventOverrideRow;
CREATE INDEX calendar_overrides_label_idx ON calendar_event_overrides (label_id);
CREATE INDEX calendar_overrides_group_start_idx ON calendar_event_overrides (group_id, start_date_time);

CREATE TABLE deleted_members (
  id TEXT NOT NULL PRIMARY KEY,
  account_id TEXT,
  owner_id TEXT,
  hiragana_first_name TEXT,
  hiragana_last_name TEXT,
  kanji_first_name TEXT,
  kanji_last_name TEXT,
  first_name TEXT,
  last_name TEXT,
  display_name TEXT NOT NULL,
  type TEXT,
  birthday INTEGER,
  gender TEXT,
  email TEXT,
  phone_number TEXT
) AS SqliteDeletedMemberRow;

CREATE TABLE deleted_groups (
  id TEXT NOT NULL PRIMARY KEY,
  owner_id TEXT NOT NULL,
  name TEXT NOT NULL,
  memo TEXT,
  color TEXT NOT NULL DEFAULT '#4CAF50',
  text_color TEXT CHECK (text_color IS NULL OR (length(text_color) = 7 AND substr(text_color, 1, 1) = '#' AND substr(text_color, 2) NOT GLOB '*[^0-9a-fA-F]*'))
) AS SqliteDeletedGroupRow;
