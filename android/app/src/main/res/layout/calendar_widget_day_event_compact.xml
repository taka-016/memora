<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_preview" android:layout_width="match_parent" android:layout_height="8dp" android:gravity="center_vertical">
    <TextView android:id="@+id/calendar_preview_bar" android:layout_width="3dp" android:layout_height="match_parent"/>
    <TextView android:id="@+id/calendar_preview_gap" android:layout_width="2dp" android:layout_height="1dp"/>
    <TextView android:id="@+id/calendar_preview_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:gravity="center_vertical" android:includeFontPadding="false" android:textSize="8sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
