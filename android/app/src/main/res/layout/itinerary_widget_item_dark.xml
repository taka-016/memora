<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itinerary_item_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="4dp" android:baselineAligned="false">
    <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/itinerary_item_start" android:layout_width="match_parent" android:layout_height="12dp"
            android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#EEEEEE" android:includeFontPadding="false" android:maxLines="1"/>
        <TextView android:id="@+id/itinerary_item_separator" android:layout_width="match_parent" android:layout_height="12dp"
            android:gravity="center" android:text="|" android:textSize="11sp" android:textStyle="bold" android:textColor="#EEEEEE" android:includeFontPadding="false"/>
        <TextView android:id="@+id/itinerary_item_end" android:layout_width="match_parent" android:layout_height="12dp"
            android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#EEEEEE" android:includeFontPadding="false" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/itinerary_item_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:textColor="#EEEEEE" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
