<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center_horizontal|bottom" android:orientation="horizontal" android:baselineAligned="true">
        <TextView android:id="@+id/calendar_day_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:includeFontPadding="false" android:maxLines="1" android:textSize="9sp"/>
        <TextView android:id="@+id/calendar_day_rokuyo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="1dp" android:includeFontPadding="false" android:maxLines="1" android:textSize="6sp" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/calendar_day_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
