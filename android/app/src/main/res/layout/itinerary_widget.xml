<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <LinearLayout android:id="@+id/itinerary_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="18dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:id="@+id/itinerary_previous" android:layout_width="56dp" android:layout_height="match_parent"
                android:gravity="center" android:text="&lt;" android:textSize="36sp" android:textStyle="bold"
                android:includeFontPadding="false" android:textColor="#212121" android:contentDescription="前の旅程"/>
            <LinearLayout android:id="@+id/itinerary_trip_header" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/itinerary_trip_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:textColor="#212121" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/itinerary_trip_period" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="11sp" android:textColor="#212121" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/itinerary_next" android:layout_width="56dp" android:layout_height="match_parent"
                android:gravity="center" android:text="&gt;" android:textSize="36sp" android:textStyle="bold"
                android:includeFontPadding="false" android:textColor="#212121" android:contentDescription="次の旅程"/>
        </LinearLayout>
        <TextView android:id="@+id/itinerary_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#212121" android:maxLines="1"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
            <ListView android:id="@+id/itinerary_items" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="#E0E0E0" android:dividerHeight="1dp" android:scrollbars="vertical"/>
            <TextView android:id="@+id/itinerary_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="top" android:textSize="14sp" android:textColor="#212121"/>
        </FrameLayout>
        <TextView android:id="@+id/itinerary_recent" android:layout_width="76dp" android:layout_height="22dp" android:layout_marginTop="4dp"
            android:gravity="center" android:text="直近の旅程" android:textSize="10sp" android:textStyle="bold" android:textColor="#212121"/>
    </LinearLayout>
    <TextView android:id="@+id/itinerary_message" android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textColor="#212121" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
        android:gravity="end|center_vertical" android:paddingEnd="8dp" android:baselineAligned="false">
        <TextView android:id="@+id/itinerary_last_updated" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:includeFontPadding="false" android:textSize="10sp" android:textColor="#212121" android:maxLines="1"/>
        <ImageView android:id="@+id/itinerary_refresh" android:layout_width="36dp" android:layout_height="match_parent"
            android:scaleType="center" android:src="@drawable/ic_widget_refresh" android:contentDescription="更新"/>
    </LinearLayout>
</FrameLayout>
