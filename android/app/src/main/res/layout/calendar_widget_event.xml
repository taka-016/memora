<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/MemoraWidgetLight"
    android:id="@+id/calendar_event_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/calendar_event_time_column" android:layout_width="44dp" android:layout_height="28dp" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/calendar_event_start" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="?attr/widgetTextColor"/>
        <TextView android:id="@+id/calendar_event_separator" android:layout_width="match_parent" android:layout_height="4dp"
            android:gravity="center" android:text="|" android:textSize="11sp" android:includeFontPadding="false" android:textColor="?attr/widgetSecondaryTextColor"/>
        <TextView android:id="@+id/calendar_event_end" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1dp" android:textColor="?attr/widgetTextColor"/>
    </LinearLayout>
    <TextView android:id="@+id/calendar_event_bar" android:layout_width="3dp" android:layout_height="28dp"/>
    <TextView android:layout_width="6dp" android:layout_height="1dp"/>
    <TextView android:id="@+id/calendar_event_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold" android:textColor="?attr/widgetTextColor"/>
</LinearLayout>
