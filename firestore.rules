rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 全てのドキュメントに対して
    match /{document=**} {
      // メール確認済みの認証ユーザーのみ読み書き可能
      allow read, write: if request.auth != null
                         && request.auth.token.email_verified == true;
    }
  }
}
