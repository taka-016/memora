rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_settings/availability {
      allow get: if true;
    }

    function isVerifiedUser() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function validCalendarReference(data) {
      return data.labelType in ['group', 'member', 'custom']
             && ((data.labelType == 'group' && data.memberId == null && data.labelId == null)
                 || (data.labelType == 'member' && data.memberId is string
                     && data.memberId.size() > 0 && data.labelId == null)
                 || (data.labelType == 'custom' && data.labelId is string
                     && data.labelId.size() > 0 && data.memberId == null));
    }

    function validColor(data) {
      return !('color' in data) || (data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$'));
    }

    function validVersionedData(collection) {
      return collection != 'calendar_events' || validCalendarReference(request.resource.data);
    }

    function isInitialVersion() {
      return request.resource.data.version is int
             && request.resource.data.version == 1;
    }

    function isNextVersion() {
      return resource.data.version is int
             && resource.data.version >= 1
             && request.resource.data.version is int
             && request.resource.data.version == resource.data.version + 1;
    }

    function isStoredVersion() {
      return resource.data.version is int && resource.data.version >= 1;
    }

    match /members/{memberId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && isInitialVersion()
                       && (request.resource.data.accountId == null
                           || request.resource.data.accountId == request.auth.uid);
      allow update: if isVerifiedUser() && isNextVersion()
                       && request.resource.data.ownerId == resource.data.ownerId
                       && (request.resource.data.accountId == resource.data.accountId
                           || (resource.data.accountId == null
                               && request.resource.data.accountId == request.auth.uid
                               && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['accountId', 'version', 'updatedAt'])));
      allow delete: if isVerifiedUser() && isStoredVersion();
    }

    match /member_account_registrations/{accountId} {
      allow create: if isVerifiedUser() && request.auth.uid == accountId
                       && request.resource.data.keys().size() == 0;
      allow delete: if isVerifiedUser() && request.auth.uid == accountId;
    }

    match /member_invitations/{code} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && isInitialVersion()
                       && request.resource.data.invitationCode == code;
      allow delete: if isVerifiedUser() && isStoredVersion();
    }

    match /groups/{groupId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && isInitialVersion() && validColor(request.resource.data);
      allow update: if isVerifiedUser() && isNextVersion() && validColor(request.resource.data)
                       && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isVerifiedUser() && isStoredVersion();
    }

    match /groups/{groupId}/shopping_list_items/{itemId} {
      function validTime(value) {
        return value is int && value > 0;
      }

      function validShoppingListItem() {
        let data = request.resource.data;
        return data.keys().hasOnly([
                 'name', 'version', 'isPending', 'pendingQuantity',
                 'lastAddedAt', 'purchasedAt', 'purchasedQuantity'
               ])
               && data.name is string && data.name.size() > 0
               && ((data.isPending == true && data.pendingQuantity is string)
                   || (data.isPending == false && data.pendingQuantity == null))
               && (data.lastAddedAt == null || validTime(data.lastAddedAt))
               && ((data.purchasedAt == null && data.purchasedQuantity == null)
                   || (validTime(data.purchasedAt) && data.purchasedQuantity is string));
      }

      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && isInitialVersion() && validShoppingListItem();
      allow update: if isVerifiedUser() && isNextVersion() && validShoppingListItem()
                       && request.resource.data.name == resource.data.name;
    }

    match /group_members/{document} {
      allow read, delete: if isVerifiedUser();
      function validMembershipWrite() {
        let data = request.resource.data;
        return document == data.groupId + ':' + data.memberId && validColor(data);
      }
      allow create: if isVerifiedUser() && validMembershipWrite();
      allow update: if isVerifiedUser() && validMembershipWrite()
                       && request.resource.data.groupId == resource.data.groupId
                       && request.resource.data.memberId == resource.data.memberId;
    }

    function scopedCollection(collection) {
      return collection in ['group_events', 'member_events', 'trip_entries',
                            'calendar_events', 'dvc_point_contracts'];
    }

    match /{collection}/{document} {
      allow read: if scopedCollection(collection) && isVerifiedUser();
      allow create: if scopedCollection(collection) && isVerifiedUser()
                       && isInitialVersion() && validVersionedData(collection);
      allow update: if scopedCollection(collection) && isVerifiedUser()
                       && isNextVersion() && validVersionedData(collection)
                       && (collection == 'calendar_events' || request.resource.data.groupId == resource.data.groupId);
      allow delete: if scopedCollection(collection) && isVerifiedUser() && isStoredVersion();
    }

    match /calendar_labels/{document} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && isInitialVersion();
      allow update: if isVerifiedUser() && request.resource.data.groupId == resource.data.groupId
                       && (isNextVersion()
                           || (isStoredVersion() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCount'])
                               && request.resource.data.diff(resource.data).affectedKeys().hasAll(['eventCount'])
                               && request.resource.data.eventCount is int && request.resource.data.eventCount >= 0));
      allow delete: if isVerifiedUser() && isStoredVersion() && resource.data.eventCount == 0;
    }

    function childCollection(collection) {
      return collection in ['locations', 'tasks', 'itinerary_items',
                            'dvc_limited_points', 'dvc_point_usages', 'calendar_event_overrides'];
    }

    function parentKey(collection) {
      return collection in ['locations', 'tasks', 'itinerary_items'] ? 'tripId'
             : collection == 'calendar_event_overrides' ? 'eventId' : 'contractId';
    }

    match /{collection}/{document} {
      allow read, delete: if childCollection(collection) && isVerifiedUser();
      allow create: if childCollection(collection) && isVerifiedUser()
                       && (collection != 'calendar_event_overrides' || request.resource.data.isCancelled == true);
      allow update: if childCollection(collection) && isVerifiedUser()
                       && request.resource.data[parentKey(collection)] == resource.data[parentKey(collection)]
                       && (collection != 'calendar_event_overrides' || request.resource.data.isCancelled == true);
    }

    match /deleted_groups/{id} {
      allow create: if isVerifiedUser();
    }
    match /deleted_members/{id} {
      allow create: if isVerifiedUser();
    }
  }
}
