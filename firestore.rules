rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function isInitialVersion() {
      return request.resource.data.version is int
             && request.resource.data.version == 1;
    }

    function isNextVersion() {
      return resource.data.version is int
             && resource.data.version >= 1
             && request.resource.data.version is int
             && request.resource.data.version == resource.data.version + 1;
    }

    function isVersionedCollection(collection) {
      return collection in ['members', 'member_invitations', 'group_events',
                            'member_events', 'trip_entries', 'groups',
                            'calendar_events', 'dvc_point_contracts',
                            'calendar_labels'];
    }

    function parentAdvanced(parentCollection, parentId) {
      let path = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      let after = getAfter(path).data;
      return after.version is int
             && ((!exists(path) && after.version == 1)
                 || (get(path).data.version is int
                     && get(path).data.version >= 1
                     && after.version == get(path).data.version + 1));
    }

    function parentDeleted(parentCollection, parentId) {
      let path = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      return exists(path) && !existsAfter(path);
    }

    function aggregateChild(parentCollection, key) {
      return isVerifiedUser()
             && request.resource.data[key] is string
             && parentAdvanced(parentCollection, request.resource.data[key]);
    }

    function aggregateChildDelete(parentCollection, key) {
      return isVerifiedUser()
             && (parentDeleted(parentCollection, resource.data[key])
                 || parentAdvanced(parentCollection, resource.data[key]));
    }

    match /{collection}/{document} {
      allow read: if isVerifiedUser()
                     && collection in ['locations', 'tasks', 'itinerary_items',
                                       'group_members', 'dvc_limited_points', 'dvc_point_usages',
                                       'calendar_event_overrides'];
    }

    match /{collection}/{document} {
      allow create: if collection in ['locations', 'tasks', 'itinerary_items']
                       && aggregateChild('trip_entries', 'tripId');
      allow update: if collection in ['locations', 'tasks', 'itinerary_items']
                       && request.resource.data.tripId == resource.data.tripId
                       && aggregateChild('trip_entries', 'tripId');
      allow delete: if collection in ['locations', 'tasks', 'itinerary_items']
                       && aggregateChildDelete('trip_entries', 'tripId');
    }

    match /calendar_event_overrides/{document} {
      allow create: if aggregateChild('calendar_events', 'eventId');
      allow update: if request.resource.data.eventId == resource.data.eventId
                       && aggregateChild('calendar_events', 'eventId');
      allow delete: if aggregateChildDelete('calendar_events', 'eventId');
    }

    match /group_members/{document} {
      allow create: if aggregateChild('groups', 'groupId');
      allow update: if request.resource.data.groupId == resource.data.groupId
                       && aggregateChild('groups', 'groupId');
      allow delete: if aggregateChildDelete('groups', 'groupId');
    }

    match /{collection}/{document} {
      allow create: if collection in ['dvc_limited_points', 'dvc_point_usages']
                       && aggregateChild('dvc_point_contracts', 'contractId');
      allow update: if collection in ['dvc_limited_points', 'dvc_point_usages']
                       && request.resource.data.contractId == resource.data.contractId
                       && aggregateChild('dvc_point_contracts', 'contractId');
      allow delete: if collection in ['dvc_limited_points', 'dvc_point_usages']
                       && aggregateChildDelete('dvc_point_contracts', 'contractId');
    }

    match /{collection}/{document} {
      allow read: if isVerifiedUser() && isVersionedCollection(collection);
      allow delete: if isVerifiedUser()
                       && isVersionedCollection(collection)
                       && resource.data.version is int
                       && resource.data.version >= 1;
      allow create: if isVerifiedUser()
                       && isVersionedCollection(collection)
                       && isInitialVersion();
      allow update: if isVerifiedUser()
                       && isVersionedCollection(collection)
                       && isNextVersion();
    }

    match /calendar_labels/{document} {
      allow update: if isVerifiedUser()
                       && resource.data.version is int
                       && resource.data.version >= 1
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['eventCount'])
                       && request.resource.data.eventCount is int
                       && request.resource.data.eventCount >= 0;
    }

    match /{collection}/{document} {
      allow read, write: if isVerifiedUser()
                           && collection in ['deleted_groups', 'deleted_members'];
    }
  }
}
