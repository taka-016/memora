rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_settings/availability {
      allow get: if true;
    }

    function isVerifiedUser() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function validCalendarReference(data) {
      return data.labelType in ['group', 'member', 'custom']
             && ((data.labelType == 'group' && data.memberId == null && data.labelId == null)
                 || (data.labelType == 'member' && data.memberId is string
                     && data.memberId.size() > 0 && data.labelId == null)
                 || (data.labelType == 'custom' && data.labelId is string
                     && data.labelId.size() > 0 && data.memberId == null));
    }

    function validColor(data) {
      return !('color' in data) || (data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$'));
    }

    function validVersionedData(collection) {
      return (collection != 'calendar_events' || validCalendarReference(request.resource.data))
             && (collection != 'groups' || validColor(request.resource.data));
    }

    function isInitialVersion() {
      return request.resource.data.version is int
             && request.resource.data.version == 1;
    }

    function isNextVersion() {
      return resource.data.version is int
             && resource.data.version >= 1
             && request.resource.data.version is int
             && request.resource.data.version == resource.data.version + 1;
    }

    function isVersionedCollection(collection) {
      return collection in ['members', 'member_invitations', 'group_events',
                            'member_events', 'trip_entries', 'groups',
                            'calendar_events', 'dvc_point_contracts',
                            'calendar_labels'];
    }

    function parentAdvanced(parentCollection, parentId) {
      let path = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      let after = getAfter(path).data;
      return after.version is int
             && ((!exists(path) && after.version == 1)
                 || (get(path).data.version is int
                     && get(path).data.version >= 1
                     && after.version == get(path).data.version + 1));
    }

    function parentDeleted(parentCollection, parentId) {
      let path = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      return exists(path) && !existsAfter(path);
    }

    function permissions() {
      return get(/databases/$(database)/documents/account_permissions/$(request.auth.uid)).data;
    }

    function ownMember() {
      return permissions().memberId;
    }

    function belongs(groupId) {
      return isVerifiedUser()
             && groupId in permissions().memberGroupIds
             && exists(/databases/$(database)/documents/groups/$(groupId))
             && exists(/databases/$(database)/documents/members/$(ownMember()));
    }

    function manages(groupId) {
      return belongs(groupId) && groupId in permissions().managedGroupIds;
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    function membershipPath(groupId, memberId) {
      return /databases/$(database)/documents/group_members/$(groupId + ':' + memberId);
    }

    function matchingPermissions(accountId, memberId, data) {
      let member = getAfter(memberPath(memberId)).data;
      return member.accountId == accountId
             && data.memberId == memberId
             && data.memberGroupIds == member.groupIds
             && data.managedGroupIds == member.managedGroupIds;
    }

    function validLists(data, memberKey) {
      return data[memberKey] is list && data.managedGroupIds is list
             && data[memberKey].size() == data[memberKey].toSet().size()
             && data.managedGroupIds.size() == data.managedGroupIds.toSet().size()
             && data[memberKey].hasAll(data.managedGroupIds);
    }

    function onlyGroupChanged(before, after, key, groupId) {
      return before[key].toSet().difference([groupId].toSet())
             == after[key].toSet().difference([groupId].toSet());
    }

    function membershipMatches(memberId, groupId, data) {
      let path = membershipPath(groupId, memberId);
      let active = existsAfter(/databases/$(database)/documents/groups/$(groupId))
                   && existsAfter(path);
      return (groupId in data.groupIds) == active
             && (groupId in data.managedGroupIds)
                == (active && (getAfter(path).data.isAdministrator == true
                    || getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == memberId));
    }

    function memberPermissionsMatch(memberId, data) {
      return data.accountId == null
             || matchingPermissions(data.accountId, memberId,
                  getAfter(/databases/$(database)/documents/account_permissions/$(data.accountId)).data);
    }

    function membershipEdit(memberId) {
      let before = resource.data;
      let after = request.resource.data;
      let groupId = after.changedGroupId;
      return after.diff(before).affectedKeys().hasOnly([
               'groupIds', 'managedGroupIds', 'changedGroupId', 'version', 'updatedAt'])
             && validLists(after, 'groupIds')
             && onlyGroupChanged(before, after, 'groupIds', groupId)
             && onlyGroupChanged(before, after, 'managedGroupIds', groupId)
             && (manages(groupId)
                 || (!exists(/databases/$(database)/documents/groups/$(groupId))
                     && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == ownMember()
                     && memberId == ownMember()))
             && (parentAdvanced('groups', groupId) || parentDeleted('groups', groupId))
             && membershipMatches(memberId, groupId, after)
             && memberPermissionsMatch(memberId, after);
    }

    function readableMember(data) {
      let shared = data.groupIds.removeAll(data.groupIds.removeAll(permissions().memberGroupIds));
      return data.accountId == request.auth.uid || data.ownerId == ownMember()
             || (shared.size() > 0 && belongs(shared[0]));
    }

    match /account_permissions/{accountId} {
      allow get: if isVerifiedUser() && accountId == request.auth.uid;
      allow create: if isVerifiedUser() && accountId == request.auth.uid
                       && validLists(request.resource.data, 'memberGroupIds')
                       && request.resource.data.memberGroupIds.size() == 0
                       && matchingPermissions(accountId, request.resource.data.memberId, request.resource.data)
                       && !exists(memberPath(request.resource.data.memberId));
      allow update: if isVerifiedUser()
                       && request.resource.data.memberId == resource.data.memberId
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['memberGroupIds', 'managedGroupIds', 'changedGroupId'])
                       && validLists(request.resource.data, 'memberGroupIds')
                       && onlyGroupChanged(resource.data, request.resource.data,
                            'memberGroupIds', request.resource.data.changedGroupId)
                       && onlyGroupChanged(resource.data, request.resource.data,
                            'managedGroupIds', request.resource.data.changedGroupId)
                       && matchingPermissions(accountId, resource.data.memberId, request.resource.data)
                       && get(memberPath(resource.data.memberId)).data.version
                          < getAfter(memberPath(resource.data.memberId)).data.version
                       && getAfter(memberPath(resource.data.memberId)).data.changedGroupId
                          == request.resource.data.changedGroupId;
      allow delete: if isVerifiedUser()
                       && !existsAfter(memberPath(resource.data.memberId))
                       && (resource.data.memberId == ownMember()
                           || get(memberPath(resource.data.memberId)).data.ownerId == ownMember());
    }

    match /members/{memberId} {
      allow get, list: if isVerifiedUser() && readableMember(resource.data);
      allow create: if isVerifiedUser() && isInitialVersion()
                       && validLists(request.resource.data, 'groupIds')
                       && request.resource.data.groupIds.size() == 0
                       && (request.resource.data.accountId == request.auth.uid
                           && memberPermissionsMatch(memberId, request.resource.data)
                           || request.resource.data.accountId == null
                              && request.resource.data.ownerId == ownMember());
      allow update: if isVerifiedUser() && isNextVersion()
                       && (membershipEdit(memberId)
                           || ((resource.data.accountId == request.auth.uid || resource.data.ownerId == ownMember())
                               && request.resource.data.accountId == resource.data.accountId
                               && request.resource.data.ownerId == resource.data.ownerId
                               && request.resource.data.groupIds == resource.data.groupIds
                               && request.resource.data.managedGroupIds == resource.data.managedGroupIds));
      allow delete: if isVerifiedUser()
                       && (resource.data.accountId == request.auth.uid || resource.data.ownerId == ownMember())
                       && getAfter(/databases/$(database)/documents/deleted_members/$(memberId)).data == resource.data
                       && (resource.data.accountId == null
                           || !existsAfter(/databases/$(database)/documents/account_permissions/$(resource.data.accountId)));
    }

    match /groups/{groupId} {
      allow read: if belongs(groupId);
      allow create: if isVerifiedUser() && isInitialVersion() && validColor(request.resource.data)
                       && request.resource.data.ownerId == ownMember()
                       && membershipMatches(ownMember(), groupId, getAfter(memberPath(ownMember())).data)
                       && groupId in getAfter(memberPath(ownMember())).data.managedGroupIds;
      allow update: if manages(groupId) && isNextVersion() && validColor(request.resource.data)
                       && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if manages(groupId)
                       && getAfter(/databases/$(database)/documents/deleted_groups/$(groupId)).data == resource.data;
    }

    function membershipDataMatches(data) {
      let member = getAfter(memberPath(data.memberId)).data;
      let group = getAfter(/databases/$(database)/documents/groups/$(data.groupId)).data;
      return data.groupId in member.groupIds
             && (data.groupId in member.managedGroupIds)
                == (data.isAdministrator == true || group.ownerId == data.memberId)
             && memberPermissionsMatch(data.memberId, member);
    }

    match /group_members/{document} {
      allow read: if belongs(resource.data.groupId);
      allow create, update: if isVerifiedUser()
                       && document == request.resource.data.groupId + ':' + request.resource.data.memberId
                       && validColor(request.resource.data)
                       && (manages(request.resource.data.groupId)
                           || (!exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                               && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == ownMember()))
                       && parentAdvanced('groups', request.resource.data.groupId)
                       && membershipDataMatches(request.resource.data);
      allow delete: if manages(resource.data.groupId)
                       && parentAdvanced('groups', resource.data.groupId)
                       && !(resource.data.groupId in getAfter(memberPath(resource.data.memberId)).data.groupIds)
                       && memberPermissionsMatch(resource.data.memberId, getAfter(memberPath(resource.data.memberId)).data);
    }

    function scopedCollection(collection) {
      return collection in ['group_events', 'member_events', 'trip_entries',
                            'calendar_events', 'dvc_point_contracts'];
    }

    match /{collection}/{document} {
      allow read: if scopedCollection(collection) && belongs(resource.data.groupId);
      allow create: if scopedCollection(collection) && belongs(request.resource.data.groupId)
                       && isInitialVersion() && validVersionedData(collection);
      allow update: if scopedCollection(collection) && belongs(resource.data.groupId)
                       && belongs(request.resource.data.groupId)
                       && isNextVersion() && validVersionedData(collection)
                       && (collection == 'calendar_events' || request.resource.data.groupId == resource.data.groupId);
      allow delete: if scopedCollection(collection) && belongs(resource.data.groupId)
                       && resource.data.version is int && resource.data.version >= 1;
    }

    match /calendar_labels/{document} {
      allow read: if belongs(resource.data.groupId);
      allow create: if manages(request.resource.data.groupId) && isInitialVersion();
      allow update: if belongs(resource.data.groupId)
                       && request.resource.data.groupId == resource.data.groupId
                       && ((manages(resource.data.groupId) && isNextVersion())
                           || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCount'])
                               && request.resource.data.eventCount is int && request.resource.data.eventCount >= 0));
      allow delete: if manages(resource.data.groupId) && resource.data.eventCount == 0;
    }

    function childCollection(collection) {
      return collection in ['locations', 'tasks', 'itinerary_items',
                            'dvc_limited_points', 'dvc_point_usages', 'calendar_event_overrides'];
    }

    function parentCollection(collection) {
      return collection in ['locations', 'tasks', 'itinerary_items'] ? 'trip_entries'
             : collection == 'calendar_event_overrides' ? 'calendar_events' : 'dvc_point_contracts';
    }

    function parentKey(collection) {
      return collection in ['locations', 'tasks', 'itinerary_items'] ? 'tripId'
             : collection == 'calendar_event_overrides' ? 'eventId' : 'contractId';
    }

    function childScope(collection, data) {
      let parent = get(/databases/$(database)/documents/$(parentCollection(collection))/$(data[parentKey(collection)])).data;
      return belongs(data.groupId) && parent.groupId == data.groupId;
    }

    match /{collection}/{document} {
      allow read: if childCollection(collection) && childScope(collection, resource.data);
      allow create: if childCollection(collection) && childScope(collection, request.resource.data)
                       && parentAdvanced(parentCollection(collection), request.resource.data[parentKey(collection)])
                       && (collection != 'calendar_event_overrides' || request.resource.data.isCancelled == true);
      allow update: if childCollection(collection) && childScope(collection, resource.data)
                       && request.resource.data[parentKey(collection)] == resource.data[parentKey(collection)]
                       && childScope(collection, request.resource.data)
                       && parentAdvanced(parentCollection(collection), request.resource.data[parentKey(collection)])
                       && (collection != 'calendar_event_overrides' || request.resource.data.isCancelled == true);
      allow delete: if childCollection(collection) && childScope(collection, resource.data)
                       && (parentAdvanced(parentCollection(collection), resource.data[parentKey(collection)])
                           || parentDeleted(parentCollection(collection), resource.data[parentKey(collection)]));
    }

    match /deleted_groups/{id} {
      allow create: if manages(id) && !existsAfter(/databases/$(database)/documents/groups/$(id))
                       && request.resource.data == get(/databases/$(database)/documents/groups/$(id)).data;
    }
    match /deleted_members/{id} {
      allow create: if isVerifiedUser() && !existsAfter(memberPath(id))
                       && request.resource.data == get(memberPath(id)).data
                       && (request.resource.data.accountId == request.auth.uid || request.resource.data.ownerId == ownMember());
    }
  }
}
