rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(groupId) {
      return get(/databases/$(database)/documents/calendar_memberships/$(groupId)/accounts/$(request.auth.uid)).data;
    }
    function belongsTo(groupId) {
      let proof = membership(groupId);
      let member = get(/databases/$(database)/documents/members/$(proof.memberId)).data;
      let entry = get(/databases/$(database)/documents/group_members/$(proof.membershipId)).data;
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId))
        && member.accountId == request.auth.uid
        && entry.groupId == groupId && entry.memberId == proof.memberId;
    }
    function active(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('calendarDeleting', false) == false;
    }
    function references(data) {
      return data.get('referencedLabelIds', [data.labelId]);
    }
    function validOverrideLabel(data, index) {
      let refs = references(data);
      let changes = data.get('overrides', {});
      return refs.size() <= index || !(refs[index] in changes)
        || (changes[refs[index]] is list);
    }
    function validEvent(data) {
      let refs = references(data);
      let changes = data.get('overrides', {});
      let cancellations = data.get('cancelledOccurrences', []);
      let rule = data.get('recurrenceRule', null);
      return data.groupId is string && data.labelId is string
        && data.title is string && data.title.matches('.*[^ \\t\\r\\n].*')
        && data.startDateTime is timestamp && data.endDateTime is timestamp
        && data.endDateTime >= data.startDateTime && data.isAllDay is bool
        && getAfter(/databases/$(database)/documents/calendar_labels/$(data.labelId)).data.groupId == data.groupId
        && refs is list && refs.size() >= 1 && refs.size() <= 3
        && refs.toSet().size() == refs.size() && refs.hasAny([data.labelId])
        && changes is map && cancellations is list
        && changes.keys().toSet().union([data.labelId].toSet()) == refs.toSet()
        && validOverrideLabel(data, 0) && validOverrideLabel(data, 1) && validOverrideLabel(data, 2)
        && ((rule == null && changes.size() == 0 && cancellations.size() == 0)
          || (rule is string && rule.size() > 0 && (data.isAllDay || (data.get('timeZone', null) is string && data.timeZone.size() > 0))));
    }
    function referenceChange(groupId, eventId, before, after, index, delta) {
      let refs = delta == 1 ? after : before;
      let other = delta == 1 ? before : after;
      return refs.size() <= index || other.hasAny([refs[index]])
        || (getAfter(/databases/$(database)/documents/calendar_labels/$(refs[index])).data.groupId == groupId
          && countChanged(refs[index], eventId, delta));
    }
    function validReferenceChanges(groupId, eventId, before, after) {
      return before.toSet().union(after.toSet()).size() <= 3
        && referenceChange(groupId, eventId, before, after, 0, 1)
        && referenceChange(groupId, eventId, before, after, 1, 1)
        && referenceChange(groupId, eventId, before, after, 2, 1)
        && referenceChange(groupId, eventId, before, after, 0, -1)
        && referenceChange(groupId, eventId, before, after, 1, -1)
        && referenceChange(groupId, eventId, before, after, 2, -1);
    }
    function countChanged(labelId, eventId, delta) {
      let before = get(/databases/$(database)/documents/calendar_labels/$(labelId)).data;
      let after = getAfter(/databases/$(database)/documents/calendar_labels/$(labelId)).data;
      return after.eventCount == before.eventCount + delta && after.lastEventId == eventId;
    }
    function validCountChange(labelId, data) {
      let path = /databases/$(database)/documents/calendar_events/$(data.lastEventId);
      let wasReferenced = exists(path) && references(get(path).data).hasAny([labelId]);
      let isReferenced = existsAfter(path) && references(getAfter(path).data).hasAny([labelId]);
      return data.lastEventId is string
        && ((existsAfter(path) && splitting(getAfter(path).data))
          ? validSplitCount(labelId, data, path)
          : ((wasReferenced && !isReferenced && data.eventCount == resource.data.eventCount - 1)
            || (!wasReferenced && isReferenced && data.eventCount == resource.data.eventCount + 1)));
    }
    function splitting(data) {
      let id = data.get('splitEventId', null);
      return id != null && !exists(/databases/$(database)/documents/calendar_events/$(id));
    }
    function validSplitSource(eventId, data) {
      let tailId = data.splitEventId;
      let tail = getAfter(/databases/$(database)/documents/calendar_events/$(tailId)).data;
      return tailId is string && tailId != eventId
        && tail.get('splitFromEventId', null) == eventId && tail.groupId == data.groupId
        && resource.data.get('recurrenceRule', null) is string && data.get('recurrenceRule', null) is string;
    }
    function validSplitTail(eventId, data) {
      let id = data.splitFromEventId;
      let sourcePath = /databases/$(database)/documents/calendar_events/$(id);
      let source = getAfter(sourcePath).data;
      return id is string && id != eventId && exists(sourcePath)
        && source.get('splitEventId', null) == eventId && source.groupId == data.groupId
        && source.get('recurrenceRule', null) is string;
    }
    function splitDelta(labelId, before, head, tail) {
      return (head.hasAny([labelId]) ? 1 : 0) + (tail.hasAny([labelId]) ? 1 : 0) - (before.hasAny([labelId]) ? 1 : 0);
    }
    function splitLabel(groupId, eventId, before, head, tail, labelId) {
      let delta = splitDelta(labelId, before, head, tail);
      let label = getAfter(/databases/$(database)/documents/calendar_labels/$(labelId)).data;
      return label.groupId == groupId
        && (delta == 0 || (label.lastEventId == eventId && label.get('lastMutationAt', null) == request.time));
    }
    function splitReference(identity, before, head, tail, refs, index, checked) {
      return refs.size() <= index || checked.hasAny([refs[index]])
        || splitLabel(identity[0], identity[1], before, head, tail, refs[index]);
    }
    function validSplitReferences(eventId, data) {
      let identity = [data.groupId, eventId];
      let before = references(resource.data);
      let head = references(data);
      let tail = references(getAfter(/databases/$(database)/documents/calendar_events/$(data.splitEventId)).data);
      return before.toSet().union(head.toSet()).union(tail.toSet()).size() <= 3
        && splitReference(identity, before, head, tail, before, 0, [])
        && splitReference(identity, before, head, tail, before, 1, [])
        && splitReference(identity, before, head, tail, before, 2, [])
        && splitReference(identity, before, head, tail, head, 0, before)
        && splitReference(identity, before, head, tail, head, 1, before)
        && splitReference(identity, before, head, tail, head, 2, before)
        && splitReference(identity, before, head, tail, tail, 0, before.concat(head))
        && splitReference(identity, before, head, tail, tail, 1, before.concat(head))
        && splitReference(identity, before, head, tail, tail, 2, before.concat(head));
    }
    function validSplitCount(labelId, data, path) {
      let source = getAfter(path).data;
      let before = references(get(path).data);
      let head = references(source);
      let tail = references(getAfter(/databases/$(database)/documents/calendar_events/$(source.splitEventId)).data);
      let delta = splitDelta(labelId, before, head, tail);
      return delta != 0 && data.eventCount == resource.data.eventCount + delta;
    }

    function validLabel(data) {
      return data.groupId is string && data.name is string && data.name.matches('.*[^ \\t\\r\\n].*')
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.get('textColor', '#FFFFFF') is string
        && data.get('textColor', '#FFFFFF').matches('^#[0-9a-fA-F]{6}$')
        && data.get('sortOrder', 0) is int && data.get('sortOrder', 0) >= 0
        && data.eventCount is int && data.eventCount >= 0;
    }

    match /calendar_memberships/{groupId}/accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberId', 'membershipId'])
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.accountId == uid
        && get(/databases/$(database)/documents/group_members/$(request.resource.data.membershipId)).data.groupId == groupId
        && get(/databases/$(database)/documents/group_members/$(request.resource.data.membershipId)).data.memberId == request.resource.data.memberId;
    }
    match /calendar_events/{eventId} {
      allow read: if signedIn() && belongsTo(resource.data.groupId);
      allow create: if signedIn() && belongsTo(request.resource.data.groupId)
        && active(request.resource.data.groupId) && validEvent(request.resource.data)
        && (request.resource.data.get('splitFromEventId', null) != null
          ? validSplitTail(eventId, request.resource.data)
          : validReferenceChanges(request.resource.data.groupId, eventId, [], references(request.resource.data)));
      allow update: if signedIn() && belongsTo(resource.data.groupId) && active(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId && validEvent(request.resource.data)
        && (splitting(request.resource.data)
          ? (validSplitSource(eventId, request.resource.data) && validSplitReferences(eventId, request.resource.data))
          : validReferenceChanges(resource.data.groupId, eventId, references(resource.data), references(request.resource.data)));
      allow delete: if signedIn() && belongsTo(resource.data.groupId)
        && validReferenceChanges(resource.data.groupId, eventId, references(resource.data), []);
    }
    match /calendar_labels/{labelId} {
      allow read: if signedIn() && belongsTo(resource.data.groupId);
      allow create: if signedIn() && belongsTo(request.resource.data.groupId) && active(request.resource.data.groupId)
        && validLabel(request.resource.data) && request.resource.data.eventCount == 0 && request.resource.data.lastEventId == null;
      allow update: if signedIn() && belongsTo(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId && validLabel(request.resource.data)
        && ((active(resource.data.groupId) && request.resource.data.eventCount == resource.data.eventCount
              && request.resource.data.lastEventId == resource.data.lastEventId
              && request.resource.data.get('lastMutationAt', null) == resource.data.get('lastMutationAt', null))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCount', 'lastEventId', 'lastMutationAt'])
              && validCountChange(labelId, request.resource.data)));
      allow delete: if signedIn() && belongsTo(resource.data.groupId) && resource.data.eventCount == 0;
    }

    // 既存データの読取は所属参照の作成に必要。書込権限は既存ルールと統合する。
    match /members/{memberId} { allow read: if signedIn(); }
    match /group_members/{membershipId} { allow read: if signedIn(); }
    match /groups/{groupId} { allow read: if signedIn(); }
  }
}
